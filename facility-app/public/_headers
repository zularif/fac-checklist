# Cloudflare caching rules (Pages and Workers static assets).
# The service worker and the page shell must always be re-checked so phones
# pick up a new deploy; hashed files in /assets never change and can be cached.
/sw.js
  Cache-Control: no-cache
/registerSW.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
